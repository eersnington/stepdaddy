{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stepdaddy-stripe-mock",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STRIPE_IDEMPOTENCY",
        "class_name": "StripeIdempotency",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StripeIdempotency"],
    },
  ],
}
